    <decisions>
        <name>Check_Event_Date</name>
        <label>Check Event Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Tomorrow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OneDayBeforeEvent</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Event_Reminder</targetReference>
            </connector>
            <label>Is Tomorrow</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>OneDayBeforeEvent</name>
